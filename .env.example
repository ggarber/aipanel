# Gemini API key (Google AI Studio).
GOOGLE_GENERATIVE_AI_API_KEY=
# Password required to use the app.
APP_PASSWORD=
# Neon Postgres (Vercel Marketplace) for panels. Without it, panels are kept in memory.
DATABASE_URL=
# true lets new panels use the server's model (GOOGLE_GENERATIVE_AI_API_KEY). Default false.
SERVER_LLM_DEFAULT=false
